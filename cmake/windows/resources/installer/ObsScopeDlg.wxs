<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
    <UI>
      <Dialog Id="ObsScopeDlg" Width="370" Height="270" Title="!(loc.InstallDirDlg_Title)">
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)" />
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>

        <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Installation Type" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="15" Transparent="yes" NoPrefix="yes" Text="Choose how [ProductName] should be installed." />
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="!(loc.InstallDirDlgBannerBitmap)" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />

        <Control Id="ScopeGroup" Type="RadioButtonGroup" X="20" Y="56" Width="330" Height="80" Property="INSTALLSCOPE">
          <RadioButtonGroup Property="INSTALLSCOPE">
            <RadioButton Value="global" X="0" Y="0" Width="330" Height="16" Text="&amp;Standard OBS Studio installation (recommended)" />
            <RadioButton Value="portable" X="0" Y="44" Width="330" Height="16" Text="&amp;Portable OBS Studio folder" />
          </RadioButtonGroup>
        </Control>
        <Control Id="GlobalHelp" Type="Text" X="36" Y="73" Width="310" Height="24" NoPrefix="yes"
                 Text="Installs for all users into [CommonAppDataFolder]obs-studio\plugins\$(var.ProductName), where OBS Studio 33 and newer looks for plugins." />
        <Control Id="PortableHelp" Type="Text" X="36" Y="117" Width="310" Height="20" NoPrefix="yes"
                 Text="Installs into the 'plugins' folder of an OBS Studio folder you choose, e.g. a portable-mode OBS." />

        <Control Id="FolderLabel" Type="Text" X="36" Y="142" Width="290" Height="12" NoPrefix="yes" Text="OBS Studio folder:"
                 EnableCondition="INSTALLSCOPE = &quot;portable&quot;" DisableCondition="INSTALLSCOPE &lt;&gt; &quot;portable&quot;" />
        <Control Id="Folder" Type="PathEdit" X="36" Y="155" Width="240" Height="18" Property="OBSROOT" Indirect="no"
                 EnableCondition="INSTALLSCOPE = &quot;portable&quot;" DisableCondition="INSTALLSCOPE &lt;&gt; &quot;portable&quot;" />
        <Control Id="ChangeFolder" Type="PushButton" X="284" Y="154" Width="56" Height="17" Text="!(loc.InstallDirDlgChange)"
                 EnableCondition="INSTALLSCOPE = &quot;portable&quot;" DisableCondition="INSTALLSCOPE &lt;&gt; &quot;portable&quot;" />
        <Control Id="PortableNote" Type="Text" X="36" Y="178" Width="310" Height="24" NoPrefix="yes"
                 Text="The plugin will be installed to '&lt;OBS Studio folder&gt;\plugins\$(var.ProductName)'."
                 EnableCondition="INSTALLSCOPE = &quot;portable&quot;" DisableCondition="INSTALLSCOPE &lt;&gt; &quot;portable&quot;" />
      </Dialog>
    </UI>
  </Fragment>
</Wix>
